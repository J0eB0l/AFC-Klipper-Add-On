# AFC-Lite (BoxTurtle) standalone firmware: H723, 25 MHz crystal, 400 MHz,
# USB on PA11/PA12, 128 KiB bootloader (Katapult) so the app sits at
# 0x08020000.
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_STM32=y
CONFIG_MACH_STM32H723=y
CONFIG_CLOCK_FREQ=400000000
CONFIG_STM32_FLASH_START_20000=y
CONFIG_STM32_CLOCK_REF_25M=y
CONFIG_STM32_USB_PA11_PA12=y
CONFIG_USBSERIAL=y
CONFIG_TURTLE_STANDALONE=y
