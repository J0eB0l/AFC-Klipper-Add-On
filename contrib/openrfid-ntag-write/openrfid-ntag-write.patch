+    # Reader-A: NTAG/Ultralight, write a page (4 bytes)
+    def __reader_a_ultralight_page_write(self, page:int, buff:list) -> int:
+        outbuf = [0] * 6
+        inbuf = [0] * 1
+        cmd = Fm175xxCmdMetaData()
+
+        # Unlike the MIFARE Classic write (0xA0), which sends the command and
+        # the data as two separate transceives, WRITE (0xA2) carries the page
+        # and its 4 bytes in ONE frame. Both answer the same way: a 4-bit ACK
+        # of 0x0A, with no CRC of its own.
+        cmd.send_crc_en = Constants.FM175XX_SET
+        cmd.recv_crc_en = Constants.FM175XX_RESET
+        cmd.send_buff = outbuf
+        cmd.recv_buff = inbuf
+        cmd.send_buff[0] = 0xA2
+        cmd.send_buff[1] = page
+        cmd.send_buff[2:6] = buff[0:4]
+        cmd.bytes_to_send = 6
+        cmd.bits_to_send = 0
+        cmd.bits_to_recv = 0
+        cmd.bytes_to_recv = 1
+        cmd.timeout = 10
+        cmd.cmd = Constants.FM175XX_CMD_TRANSCEIVE
+        result = self.__command_exe(cmd)
+
+        if (result.err_code != Constants.FM175XX_OK):
+            return result.err_code
+
+        if ((cmd.bits_recved != 4) or (cmd.recv_buff[0] & 0x0F != 0x0A)):
+            return Constants.FM175XX_CARD_WRITE_ERR
+
+        return Constants.FM175XX_OK
+
+    # Reader-A: NTAG215, write pages and read them back
+    def __reader_a_ultralight_write_all_data(self, start_page:int, data:list, retry_times = 3) -> Fm175xxReturnVal:
+        ret = Fm175xxReturnVal()
+        per_page = Constants.FM175XX_NTAG215_BYTES_PER_PAGE
+
+        if ((len(data) == 0) or (len(data) % per_page != 0)):
+            ret.err_code = Constants.FM175XX_PARAM_ERR
+            return ret
+
+        pages = len(data) // per_page
+        end_page = start_page + pages - 1
+
+        # Pages below USER_START are the UID, the one-way static lock bits and
+        # the capability container; pages above USER_END are the dynamic lock
+        # bits, the configuration and the password. Those are fuses, not
+        # storage, so a caller's page arithmetic is checked here rather than
+        # trusted: the failure mode is a permanently dead tag.
+        if ((start_page < Constants.FM175XX_NTAG215_USER_START_PAGE) or
+                (end_page > Constants.FM175XX_NTAG215_USER_END_PAGE)):
+            ret.err_code = Constants.FM175XX_PARAM_ERR
+            return ret
+
+        for page_no in range(pages):
+            err_code = Constants.FM175XX_CARD_WRITE_ERR
+            page_data = data[page_no * per_page : (page_no + 1) * per_page]
+            for _ in range(retry_times):
+                err_code = self.__reader_a_ultralight_page_write(start_page + page_no, page_data)
+                if (err_code == Constants.FM175XX_OK):
+                    break
+            if (err_code != Constants.FM175XX_OK):
+                ret.err_code = err_code
+                return ret
+
+        # Read back and compare. A tag that ACKs and stores nothing is a real
+        # failure mode (a sticker leaving the field mid-write), and it is
+        # indistinguishable from success without this.
+        for page_no in range(0, pages, 4):
+            result = Fm175xxReturnVal()
+            for _ in range(retry_times):
+                result = self.__reader_a_ultralight_page_read(start_page + page_no)
+                if (result.err_code == Constants.FM175XX_OK):
+                    break
+            if (result.err_code != Constants.FM175XX_OK):
+                ret.err_code = Constants.FM175XX_CARD_READ_ERR
+                return ret
+
+            area = page_no * per_page
+            to_check = min(16, len(data) - area)
+            if (result.out_data[0 : to_check] != data[area : area + to_check]):
+                ret.err_code = Constants.FM175XX_CARD_WRITE_ERR
+                return ret
+
+        ret.err_code = Constants.FM175XX_OK
+        ret.out_data = data
+        return ret
+
